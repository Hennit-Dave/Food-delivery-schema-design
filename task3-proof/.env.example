# Copy this file to .env and fill in a NEW, isolated Neon project's connection strings.
# .env is gitignored; never commit real credentials.
#
# DATABASE_URL may be Neon's pooled (PgBouncer) endpoint - used for ordinary app-style access.
# DIRECT_URL must be Neon's direct (non-pooled) endpoint - required for migrations and for the
# two-connection concurrency test, which holds one transaction open while a second connection
# contends for the same lock.
DATABASE_URL=postgres://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DIRECT_URL=postgres://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require&connect_timeout=10
